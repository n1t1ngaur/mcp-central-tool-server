MCP_PROTOCOL_MODE=auto
MCP_CLIENT_NAME=mcp-ai-host
MCP_CLIENT_VERSION=1.0.0
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SERVER_PATH=/mcp

