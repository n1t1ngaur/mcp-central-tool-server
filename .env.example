COUNTRY_API_KEY=your_actual_api_key
COUNTRY_API_URL=your_country_api_url
COUNTRY_TOOLNAME=get_countries
COUNTRY_DESCRIPTION=Get country information

MAILBOX_API_KEY=your_actual_api_key
MAILBOX_API_URL=your_mailbox_api_url
